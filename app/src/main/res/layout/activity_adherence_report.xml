<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="@dimen/activity_horizontal_margin"
    android:gravity="center_horizontal">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/adherence_report"
        android:textSize="@dimen/text_size_large"
        android:textStyle="bold"
        android:textColor="@color/colorPrimary"
        android:layout_marginBottom="32dp"
        android:layout_marginTop="24dp"/>

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="8dp"
        xmlns:app="http://schemas.android.com/apk/res-auto">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:id="@+id/tvTotalDoses"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                tools:text="Total Scheduled Doses: 0"
                android:textSize="@dimen/text_size_medium"
                android:layout_marginBottom="12dp"/>

            <TextView
                android:id="@+id/tvTakenDoses"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                tools:text="Taken Doses: 0"
                android:textSize="@dimen/text_size_medium"
                android:textColor="@color/colorPrimary"
                android:layout_marginBottom="12dp"/>

            <TextView
                android:id="@+id/tvMissedDoses"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                tools:text="Missed Doses: 0"
                android:textSize="@dimen/text_size_medium"
                android:textColor="@color/colorError"
                android:layout_marginBottom="24dp"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/gray"
                android:layout_marginBottom="24dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/adherence_percentage"
                android:textSize="16sp"
                android:textAlignment="center"/>

            <TextView
                android:id="@+id/tvAdherencePercentage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                tools:text="0%"
                android:textSize="48sp"
                android:textStyle="bold"
                android:textColor="@color/colorPrimary"
                android:textAlignment="center"
                android:layout_marginTop="8dp"/>

        </LinearLayout>
    </androidx.cardview.widget.CardView>

</LinearLayout>
